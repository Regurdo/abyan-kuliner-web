# ============================================================
# KUNCI TOKO KUE IBU
# ------------------------------------------------------------
# Salin file ini menjadi ".env.local" lalu isi ketiganya
# dari dashboard Supabase: Settings -> Data API (atau API).
# Setelah mengisi, jalankan ulang: bun run dev
# ============================================================

# 1) Alamat project Supabase kamu (Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# 2) Kunci publik (anon / public / publishable) — aman dipakai pembeli
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3) Kunci induk (service_role / secret) — RAHASIA, hanya untuk server.
#    Jangan pernah dibagikan atau dipush ke GitHub.
SUPABASE_SERVICE_ROLE_KEY=
